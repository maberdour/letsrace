{
  "Name": "BC-Events",
  "CreationDate": "2026-3-9",
  "Commands": [
    {
      "Command": "selectWindow",
      "Target": "TAB=CLOSEALLOTHER",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "XRun",
      "Target": "cmd.exe",
      "Value": "/c del \"H:\\My Drive\\Clients\\LetsRace\\UIVision\\datasources\\event_data.csv\"",
      "Description": "Delete existing output file"
    },
    {
      "Command": "store",
      "Target": "fast",
      "Value": "!replayspeed",
      "Description": ""
    },
    {
      "Command": "csvReadArray",
      "Target": "URLS-BC.csv",
      "Value": "urlData",
      "Description": "Read all URLs from CSV"
    },
    {
      "Command": "executeScript_Sandbox",
      "Target": "return ${urlData}.length;",
      "Value": "urlCount",
      "Description": "Get number of URLs"
    },
    {
      "Command": "store",
      "Target": "0",
      "Value": "urlIndex",
      "Description": "Start at row 0 (first data row after header)"
    },
    {
      "Command": "while_v2",
      "Target": "${urlIndex} < ${urlCount}",
      "Value": "",
      "Description": "Loop through all URLs"
    },
    {
      "Command": "executeScript_Sandbox",
      "Target": "return ${urlData}[${urlIndex}][0];",
      "Value": "regionName",
      "Description": "Get region name from column A"
    },
    {
      "Command": "executeScript_Sandbox",
      "Target": "return ${urlData}[${urlIndex}][1];",
      "Value": "currentUrl",
      "Description": "Get URL from column B"
    },
    {
      "Command": "echo",
      "Target": "Processing region: ${regionName}",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "open",
      "Target": "${currentUrl}",
      "Value": "",
      "Description": "Open the URL from CSV"
    },
    {
      "Command": "pause",
      "Target": "4000",
      "Value": "",
      "Description": "Give any Cloudflare challenge time to render"
    },
    {
      "Command": "executeScript",
      "Target": "return /just a moment|security validation|security verification|verify you are human/i.test(document.title + ' ' + (document.body ? document.body.innerText : '')) ? 1 : 0;",
      "Value": "cfChallenge",
      "Description": "Detect Cloudflare 'Performing security validation' page"
    },
    {
      "Command": "store",
      "Target": "0",
      "Value": "cfAttempt",
      "Description": ""
    },
    {
      "Command": "while_v2",
      "Target": "${cfChallenge} == 1 && ${cfAttempt} < 3",
      "Value": "",
      "Description": "Try up to 3 times to pass the Cloudflare check"
    },
    {
      "Command": "echo",
      "Target": "Cloudflare challenge detected for ${regionName} (attempt ${cfAttempt}) - clicking 'Verify you are human'",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "store",
      "Target": "true",
      "Value": "!errorignore",
      "Description": "Don't fail the macro if the checkbox text isn't found (e.g. challenge auto-solved)"
    },
    {
      "Command": "XClick",
      "Target": "xpath=(//h1|//h2)[1]",
      "Value": "",
      "Description": "Focus the page at the heading above the Turnstile widget"
    },
    {
      "Command": "XType",
      "Target": "${KEY_TAB}",
      "Value": "",
      "Description": "Tab onto the 'Verify you are human' checkbox (it is in a closed shadow root + cross-origin iframe, so no locator can target it)"
    },
    {
      "Command": "XType",
      "Target": "${KEY_SPACE}",
      "Value": "",
      "Description": "Tick the checkbox"
    },
    {
      "Command": "store",
      "Target": "false",
      "Value": "!errorignore",
      "Description": "Restore normal error handling"
    },
    {
      "Command": "pause",
      "Target": "8000",
      "Value": "",
      "Description": "Wait for Cloudflare to verify and redirect"
    },
    {
      "Command": "executeScript",
      "Target": "return /just a moment|security validation|security verification|verify you are human/i.test(document.title + ' ' + (document.body ? document.body.innerText : '')) ? 1 : 0;",
      "Value": "cfChallenge",
      "Description": "Re-check whether the challenge is still showing"
    },
    {
      "Command": "executeScript_Sandbox",
      "Target": "return Number(${cfAttempt}) + 1;",
      "Value": "cfAttempt",
      "Description": ""
    },
    {
      "Command": "end",
      "Target": "",
      "Value": "",
      "Description": "End Cloudflare challenge loop"
    },
    {
      "Command": "store",
      "Target": "60",
      "Value": "!TIMEOUT_WAIT",
      "Description": "Allow up to 60s for initial page load"
    },
    {
      "Command": "waitForElementPresent",
      "Target": "xpath=//tr[contains(@class,'events--desktop__row')]",
      "Value": "",
      "Description": "Wait until at least one event row is visible"
    },
    {
      "Command": "store",
      "Target": "10",
      "Value": "!TIMEOUT_WAIT",
      "Description": "Tighten implicit wait for per-row extraction to 10s"
    },
    {
      "Command": "store",
      "Target": "1",
      "Value": "continuePagination",
      "Description": ""
    },
    {
      "Command": "while_v2",
      "Target": "${continuePagination} == 1",
      "Value": "",
      "Description": "Pagination loop"
    },
    {
      "Command": "storeXpathCount",
      "Target": "xpath=(//tr[contains(@class, 'events--desktop__row')]//a[contains(@class, 'event--race__title')])",
      "Value": "filesCount",
      "Description": ""
    },
    {
      "Command": "echo",
      "Target": "Number of rows to extract = ${filesCount}",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "store",
      "Target": "1",
      "Value": "loopCount",
      "Description": ""
    },
    {
      "Command": "while_v2",
      "Target": "${loopCount} <= ${filesCount}",
      "Value": "",
      "Description": "Loop through each event row"
    },
    {
      "Command": "echo",
      "Target": "Loop number: ${loopCount}",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "store",
      "Target": "true",
      "Value": "!statusOK",
      "Description": "Reset !statusOK before checking if the current row exists"
    },
    {
      "Command": "verifyElementPresent",
      "Target": "xpath=(//tr[contains(@class, 'events--desktop__row')]//td[contains(@class, 'event--date__column')])[${loopCount}]",
      "Value": "true",
      "Description": "Check whether the row for this loopCount actually exists"
    },
    {
      "Command": "if",
      "Target": "${!statusOK}",
      "Value": "",
      "Description": "Only extract and save row data if the row exists"
    },
    {
      "Command": "storeText",
      "Target": "xpath=(//tr[contains(@class, 'events--desktop__row')]//td[contains(@class, 'event--date__column')])[${loopCount}]",
      "Value": "!csvLine",
      "Description": "Extract date"
    },
    {
      "Command": "storeText",
      "Target": "xpath=(//tr[contains(@class, 'events--desktop__row')]//a[contains(@class, 'event--race__title')])[${loopCount}]",
      "Value": "!csvLine",
      "Description": "Extract event title"
    },
    {
      "Command": "storeText",
      "Target": "xpath=(//tr[contains(@class, 'events--desktop__row')]//td[contains(@class, 'event--type__row')])[${loopCount}]",
      "Value": "!csvLine",
      "Description": "Extract event type"
    },
    {
      "Command": "storeText",
      "Target": "xpath=(//tr[contains(@class, 'events--desktop__row')]//td[6])[${loopCount}]",
      "Value": "!csvLine",
      "Description": "Extract column 6"
    },
    {
      "Command": "storeAttribute",
      "Target": "xpath=(//a[@class='button-expand show-races event--race__title'])[${loopCount}]@href",
      "Value": "!csvLine",
      "Description": "Extract event link"
    },
    {
      "Command": "store",
      "Target": "${regionName}",
      "Value": "!csvLine",
      "Description": "Add region name"
    },
    {
      "Command": "csvSave",
      "Target": "event_data",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "executeScript_Sandbox",
      "Target": "return Number(${loopCount}) + 1;",
      "Value": "loopCount",
      "Description": ""
    },
    {
      "Command": "else",
      "Target": "",
      "Value": "",
      "Description": "Row does not exist (beyond actual rows): bump loopCount to end the row loop without writing a line"
    },
    {
      "Command": "executeScript_Sandbox",
      "Target": "return Number(${filesCount}) + 1;",
      "Value": "loopCount",
      "Description": ""
    },
    {
      "Command": "end",
      "Target": "",
      "Value": "",
      "Description": "End per-row existence check"
    },
    {
      "Command": "end",
      "Target": "",
      "Value": "",
      "Description": "End event row loop"
    },
    {
      "Command": "store",
      "Target": "true",
      "Value": "!errorignore",
      "Description": "Allow macro to continue after verifyElementPresent error on last page"
    },
    {
      "Command": "store",
      "Target": "true",
      "Value": "!statusOK",
      "Description": "Reset !statusOK before verifying Next link"
    },
    {
      "Command": "verifyElementPresent",
      "Target": "xpath=//div[@class='pagination']//a[contains(@class, 'next') and @href]",
      "Value": "true",
      "Description": "Check for next page (does not stop macro because !errorignore=true)"
    },
    {
      "Command": "if",
      "Target": "${!statusOK}",
      "Value": "",
      "Description": "If Next link exists, click it and continue pagination"
    },
    {
      "Command": "click",
      "Target": "xpath=//div[@class='pagination']//a[contains(@class, 'next') and @href]",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "pause",
      "Target": "2000",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "else",
      "Target": "",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "echo",
      "Target": "No more next page. Stopping.",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "store",
      "Target": "0",
      "Value": "continuePagination",
      "Description": ""
    },
    {
      "Command": "end",
      "Target": "",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "end",
      "Target": "",
      "Value": "",
      "Description": "End pagination loop"
    },
    {
      "Command": "executeScript_Sandbox",
      "Target": "return Number(${urlIndex}) + 1;",
      "Value": "urlIndex",
      "Description": "Move to next URL"
    },
    {
      "Command": "end",
      "Target": "",
      "Value": "",
      "Description": "End URL loop"
    }
  ]
}